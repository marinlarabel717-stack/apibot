# Telegram 机器人 Token
BOT_TOKEN=

# 管理员 Telegram ID，多个用英文逗号分隔
ADMIN_USER_IDS=123456789

# 补货通知发送到哪个频道或群
RESTOCK_CHANNEL=@xxx

# 客服联系方式，显示给用户看
CUSTOMER_SERVICE_CONTACT=@id2uu

# OkayPay 商户 ID
OKPAY_SHOP_ID=

# OkayPay 商户密钥
OKPAY_SHOP_TOKEN=

# 支付名称，显示给用户看
OKPAY_NAME=号铺

# 支付回调地址，填你对外可访问的 URL
OKPAY_CALLBACK_URL=

# OkayPay 接口地址
OKPAY_API_URL=https://api.okaypay.me/shop

# 本地回调监听地址
OKPAY_CALLBACK_HOST=0.0.0.0

# 本地回调监听端口
OKPAY_CALLBACK_PORT=8088

# 请求 OkayPay 的超时时间，单位秒
OKPAY_REQUEST_TIMEOUT=12

# 创建订单的超时时间，单位秒
OKPAY_CREATE_TIMEOUT=8

# 轮询支付状态的间隔，单位秒
OKPAY_POLL_SECONDS=4

# 每次轮询最多处理多少订单
OKPAY_POLL_LIMIT=50

# 同时轮询多少个支付任务
OKPAY_POLL_CONCURRENCY=4

# TronGrid 接口地址
TRONGRID_API_BASE=https://api.trongrid.io/v1

# TronGrid 单个 API Key
TRONGRID_API_KEY=

# TronGrid 多个 API Key，多个用英文逗号分隔
TRONGRID_API_KEYS=

# 请求 TronGrid 的超时时间，单位秒
TRONGRID_REQUEST_TIMEOUT=20

# 轮询链上交易的间隔，单位秒
TRONGRID_POLL_SECONDS=6

# 每页拉取多少条链上记录
TRONGRID_PAGE_LIMIT=100

# 最多翻多少页链上记录
TRONGRID_MAX_PAGES=20

# 向前回看多少分钟的链上交易
TRONGRID_LOOKBACK_MINUTES=30

# TRC20-USDT 合约地址
TRC20_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# 全局默认加价金额
SELL_PRICE_ADD=0.2

# 关键词加价规则，JSON 格式
SELL_PRICE_RULES_JSON={"VIP":{"add":0.5},"Spam":{"add":0.1},"7年":{"add":0.8}}

# 是否启用按钮自定义表情
INLINE_BUTTON_CUSTOM_EMOJI_ENABLED=true

# 按钮表情 ID 映射，JSON 格式
BUTTON_CUSTOM_EMOJI_IDS_JSON={"vip":"5132131004097496494","spam":"5301246586918024418","liang":"4990325649433429541","asia":"5217464097234241939","west":"5220106983885002341","africa":"5220166546491459639","age_2_5":"5222044641200720562","age_6_12":"5954284484395273123","age_1_2y":"5217818964612108191","age_3_4y":"5193127592764394874","age_5y":"5220064167356025824","age_7y":"5215638109068220476"}

# 上游接口基础地址
API_BASE_URL=https://onlinestore-fx-api.add4533.com

# 请求上游接口超时，单位秒
API_TIMEOUT_SECONDS=20

# 上游鉴权请求头名称
API_AUTH_HEADER_NAME=Authorization

# 上游鉴权请求头内容
API_AUTH_HEADER_VALUE=你的上游API密钥

# 是否自动尝试 Bearer 鉴权写法
API_AUTH_TRY_BEARER_VARIANTS=true

# 上游鉴权 URL 参数名
API_AUTH_QUERY_NAME=

# 上游鉴权 URL 参数值
API_AUTH_QUERY_VALUE=

# 额外请求头，JSON 格式
API_EXTRA_HEADERS_JSON={}

# 额外 URL 参数，JSON 格式
API_EXTRA_QUERY_JSON={}

# 本地数据库文件路径
DATABASE_PATH=data/apibot.db

# 订单轮询间隔，单位秒
ORDER_POLL_SECONDS=5

# 新订单首次快速检查间隔，单位秒
ORDER_POLL_FIRST_SECONDS=2

# 每次最多轮询多少订单
ORDER_POLL_LIMIT=100

# 同时处理多少订单轮询
ORDER_POLL_CONCURRENCY=8

# 下单后快速探测间隔，单位秒
ORDER_FAST_PROBE_SECONDS=2

# 订单卡住多久算超时，单位秒
ORDER_STUCK_TIMEOUT_SECONDS=45

# 失败后再次补发的冷却时间，单位秒
DELIVERY_RETRY_COOLDOWN_SECONDS=60

# Telegram 媒体写入超时，单位秒
TELEGRAM_MEDIA_WRITE_TIMEOUT_SECONDS=180

# Telegram 媒体读取超时，单位秒
TELEGRAM_MEDIA_READ_TIMEOUT_SECONDS=120
